# Optional: analytics (set empty string to disable cleanly)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_GA4_MEASUREMENT_ID=

# Optional: storage/maps/voice/image proxy (required for upload/AI/maps features)
