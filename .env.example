# Required: database connection string
DATABASE_URL=mysql://app:app_pw@127.0.0.1:3306/typing_quiz_app

# Required for session signing
JWT_SECRET=change-this-to-a-long-random-string

# Optional OAuth settings
OAUTH_SERVER_URL=http://localhost:3000
VITE_OAUTH_PORTAL_URL=http://localhost:3000
VITE_APP_ID=local-dev
OWNER_EMAIL=

# Google OAuth (real social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: if empty, server derives as {origin}/login
GOOGLE_OAUTH_REDIRECT_URI=
# Optional: if set, frontend always uses this URI for Google auth start
VITE_GOOGLE_OAUTH_REDIRECT_URI=
# Frontend uses this to start Google OAuth
VITE_GOOGLE_CLIENT_ID=

# Optional: owner mapping
OWNER_OPEN_ID=
ADMIN_USERNAME=

# Safety switch: keep demo publishing locked by default
ALLOW_DEMO_PUBLISHING=false
VITE_ALLOW_DEMO_PUBLISHING=false

# Optional: analytics (set empty string to disable cleanly)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_GA4_MEASUREMENT_ID=

# Optional: storage/maps/voice/image proxy (required for upload/AI/maps features)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional OCR
OCR_ENABLED=true
GCP_PROJECT_ID=
GCS_TEMP_BUCKET=
# Optional: use Application Default Credentials (no JSON key required)
GCP_USE_ADC=true
# Optional: JSON string or base64-encoded JSON for service account key.
# Leave empty to use ADC when available.
GCP_SERVICE_ACCOUNT_JSON=
# Optional: local OCR fallback tuning
TESSERACT_LANG=kor+eng
# Example: /Users/mac/Downloads/manus.numbering.pro.v2-main
TESSERACT_LANG_PATH=
# Optional: inline PDF OCR attempt (enable if your Vision setup supports it)
OCR_INLINE_DOCUMENT_ENABLED=true
# Optional: async OCR output pages per JSON shard (1-100, bigger can reduce post-processing overhead)
OCR_OUTPUT_BATCH_SIZE=100
# Optional: inline PDF size limit in bytes (smaller PDFs can skip GCS input upload for faster start)
OCR_INLINE_DOCUMENT_MAX_BYTES=8388608
