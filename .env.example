# Required: local MySQL connection string
DATABASE_URL=mysql://app:app_pw@127.0.0.1:3306/typing_quiz_app

# Required for session signing
JWT_SECRET=change-this-to-a-long-random-string

# Optional OAuth settings (safe defaults for local testing)
OAUTH_SERVER_URL=http://localhost:3000
VITE_OAUTH_PORTAL_URL=http://localhost:3000
VITE_APP_ID=local-dev
OWNER_EMAIL=parkaryote@snu.ac.kr

# OCR stays disabled in local by default
OCR_ENABLED=false
